          break;

        case LL_RCC_LPTIM1_CLKSOURCE_PCLK1:           /* LPTIM1 Clock is PCLK1 */
        default:
          frequency = __LL_RCC_CALC_PCLK1_FREQ(__LL_RCC_CALC_HCLK1_FREQ(HAL_RCC_GetSysClockFreq(), \
                                                                        LL_RCC_GetAHBPrescaler()), \
                                               LL_RCC_GetAPB1Prescaler());

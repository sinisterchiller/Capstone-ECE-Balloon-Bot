/* USER CODE BEGIN Header */
/**
  ******************************************************************************
  * @file    telemetry_gps_status.c
  * @brief   Consumption side of the CPU1 GPS status snapshot (see
  *          telemetry_gps_status.h).
  *
  * The publication a read finds is never presented on that same read when this
  * core cannot date it: only a publication observed to replace an earlier one
  * was certainly published after a read of this core, and only such a
  * publication has an age the local counter bounds. This is what keeps a
  * snapshot inherited from an earlier CPU1 run - CPU1 halted long before CPU2
  * started - from travelling as a current fix.
  *
  * Pure C with no HAL dependency: the caller supplies the current value and
  * the rate of its own clock, so the same code runs on the target and in the
  * host test.
  ******************************************************************************
  */
/* USER CODE END Header */

/* Includes ------------------------------------------------------------------*/
#include "telemetry_gps_status.h"

#include <stddef.h>

/* Private define ------------------------------------------------------------*/
/* USER CODE BEGIN PD */
/**
  * @brief Attempts at a coherent seqlock read.
  * @note  CPU1 holds the status in the written state for a handful of stores
  *        and only when a new GGA sentence or an expiry lands, so a few
  *        immediate retries settle it. Giving up keeps the caller bounded: the
  *        radio task must never spin on the other core.
  */
#define TELEMETRY_STATUS_READ_ATTEMPTS 3u
/* USER CODE END PD */

/* Private functions ---------------------------------------------------------*/
/**
  * @brief  Fills a status as "no fix": no validity, no coordinates, no stamps.
  * @param  status  Destination status.
  */
static void Telemetry_SetNoFix(TelemetryGpsStatus *status)
{
  status->fix_sequence = 0u;
  status->fix_timestamp_ms = 0u;
  status->fix_valid = 0u;
  status->latitude_udeg = 0;
  status->longitude_udeg = 0;
  status->altitude_cm = 0;
  status->satellites_used = 0u;
}

/**
  * @brief  Records the publication of this read as the one to age.
  * @param  watch  Tracker to update.
  * @param  sequence  seqlock sequence of the publication read.
  * @param  now_ticks  Reading core's counter at this read.
  * @param  change_seen  true when the publication was seen to replace an
  *                    earlier observed one within one age window, so that
  *                    `now_ticks` bounds its age.
  */
static void Telemetry_RecordObservation(TelemetryGpsSnapshotWatch *watch,
                                        uint32_t sequence,
                                        uint32_t now_ticks,
                                        bool change_seen)
{
  watch->sequence = sequence;
  watch->observed_ticks = now_ticks;
  watch->observed = true;
  watch->change_seen = change_seen;
}

/* Exported functions --------------------------------------------------------*/
bool Telemetry_ReadGpsStatusSnapshot(const GnssVcpGpsStatus *shared,
                                     uint32_t now_ticks,
                                     uint32_t ticks_per_second,
                                     TelemetryGpsSnapshotWatch *watch,
                                     TelemetryGpsStatus *status)
{
  GnssVcpGpsStatus snapshot;
  uint8_t attempt;
  uint8_t coherent = 0u;
  uint32_t age_ticks;
  uint64_t age_limit_ticks;
  bool presentable = false;

  /* Default answer: no fix. Every rejection below returns this, so the caller
     can always encode what it is given. A NULL destination stays untouched. */
  if (status != NULL)
  {
    Telemetry_SetNoFix(status);
  }

  if ((shared == NULL) || (watch == NULL) || (status == NULL) ||
      (ticks_per_second == 0u))
  {
    return false;
  }

  for (attempt = 0u; attempt < TELEMETRY_STATUS_READ_ATTEMPTS; attempt++)
  {
    if (GNSS_VCP_TryReadGpsStatus(shared, &snapshot) != 0u)
    {
      coherent = 1u;
      break;
    }
  }

  if (coherent == 0u)
  {
    return false; /* CPU1 kept writing: report no fix rather than an old one */
  }

  if (snapshot.initialized != GNSS_VCP_GPS_STATUS_INIT_MARK)
  {
    /* Never initialised, or CPU1 restarted and has not set the region up yet
       (a reset does not clear the sequence, so the numbers of an earlier image
       must not be reused). Forget the observation and wait for a new one. */
    watch->observed = false;
    watch->change_seen = false;
    return false;
  }

  /* The age limit is converted into this core's counter instead of converting
     the age into milliseconds, which would move the wrap point of the
     arithmetic. */
  age_limit_ticks = (((uint64_t)TELEMETRY_MAX_FIX_AGE_MS) * ticks_per_second) / 1000u;

  if (watch->observed == false)
  {
    /* First coherent publication since this core started: CPU1 may have
       published it arbitrarily long before this read, so nothing here bounds
       its age. Remember which publication it is and wait until a later read
       finds it replaced. */
    Telemetry_RecordObservation(watch, snapshot.seq, now_ticks, false);
    return false;
  }

  /* Both values come from this core's counter, so the difference is valid and
     survives the counter's own wrap. */
  age_ticks = now_ticks - watch->observed_ticks;

  if (watch->sequence == snapshot.seq)
  {
    /* Same publication as the recorded one, so only its own record dates it:
       presentable when that record was made by a read that saw the
       replacement within one age window - otherwise its age is unbounded -
       and only until the window elapses, which expires a CPU1 that stopped
       publishing. The record is kept, so an expired publication stays expired
       until it is replaced. */
    presentable = (watch->change_seen && ((uint64_t)age_ticks <= age_limit_ticks));
  }
  else if ((uint64_t)age_ticks <= age_limit_ticks)
  {
    /* A different publication appeared after the recorded one, hence it was
       published between the two reads and is no older than their distance. */
    Telemetry_RecordObservation(watch, snapshot.seq, now_ticks, true);
    presentable = true;
  }
  else
  {
    /* The replacement is only noticed after a whole age window has passed, so
       the new publication may itself predate this read by almost as much.
       Record it and wait for the next replacement, exactly like the first
       observation. */
    Telemetry_RecordObservation(watch, snapshot.seq, now_ticks, false);
    return false;
  }

  if ((presentable == false) || (snapshot.fix_valid == 0u))
  {
    /* Either the publication cannot be dated, or CPU1 published "no fix". The
       publication is still recorded, so the next replacement is accepted
       without losing an interval. */
    return false;
  }

  status->fix_sequence = snapshot.seq;
  /* Diagnostic copy of the producer's stamp: it belongs to CPU1's clock and is
     never compared with now_ticks. */
  status->fix_timestamp_ms = snapshot.fix_timestamp_ms;
  status->fix_valid = 1u;
  status->latitude_udeg = snapshot.latitude_udeg;
  status->longitude_udeg = snapshot.longitude_udeg;
  status->altitude_cm = snapshot.altitude_cm;
  status->satellites_used = snapshot.satellites_used;

  return true;
}
</file>

<file path="Common/Telemetry/telemetry_gps_status.h">
/* USER CODE BEGIN Header */
/**
  ******************************************************************************
  * @file    telemetry_gps_status.h
  * @brief   Reads the GPS status snapshot published by CPU1 for telemetry.
  *
  * The snapshot itself lives in the shared SRAM1 region described by
  * gnss_vcp_mailbox.h; CPU1 updates it from every decoded GGA. This module is
  * the consumer side used by the CPU2 telemetry application: it takes a
  * coherent copy of the snapshot and decides, at the moment of consumption,
  * whether the fix may still be presented as current.
  *
  * The two cores do not share a clock. CPU1 stamps a fix with its own
  * HAL_GetTick(), i.e. SysTick milliseconds counted from CPU1 reset, while
  * CPU2 counts RTC ticks at a different rate from the free-running RTC
  * counter (CM0PLUS/Core/Src/sys_app.c returns TIMER_IF_GetTimerValue()).
  * Subtracting a CPU1 stamp from a CPU2 counter is therefore meaningless: with
  * the CPU2 origin above the CPU1 origin every fix looks stale, and with the
  * CPU2 origin below it every stale fix looks current.
  *
  * The age of a fix is consequently measured on the consumer's clock alone.
  * The consumer remembers which publication it last saw (the seqlock `seq` of
  * the snapshot) together with its own counter value when that publication
  * first appeared, and the age is the elapsed value of that same counter.
  * Counter and rate are passed by the caller, so the comparison with
  * TELEMETRY_MAX_FIX_AGE_MS happens in one time domain and the modular
  * difference stays exact at the counter's own wrap. A new publication
  * restarts the measurement; a frozen one - CPU1 stopped, faulted, held in
  * reset or no longer publishing - keeps ageing and expires on its own, no
  * matter what the CPU1 timestamps in the snapshot still say.
  *
  * That measurement cannot date the first publication a consumer sees. CPU1
  * may have published it long before CPU2 booted, or left it behind when it
  * halted, so the elapsed counter value of the first read bounds nothing: an
  * old fix would look age zero. The first coherent publication is therefore
  * only remembered and never presented. A fix becomes presentable once a read
  * observes that publication replaced within one age window, because that
  * replacement was then published after a read of this core. CPU2 sends no fix
  * in the first telemetry interval after a (re)start and a fix from a later
  * interval on, as soon as CPU1 publishes again; a snapshot inherited from an
  * earlier run can never travel as current, however old it is.
  *
  * A read that finds no initialised snapshot, a snapshot that stays busy for
  * every attempt, a no-fix status or an expired fix all resolve to the same
  * answer: a coherent no-fix status, so the caller always has something it may
  * encode and transmit. Old coordinates are never handed out as a current fix.
  ******************************************************************************
  */
/* USER CODE END Header */
/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef __TELEMETRY_GPS_STATUS_H__
#define __TELEMETRY_GPS_STATUS_H__

#ifdef __cplusplus
extern "C" {
#endif

/* Includes ------------------------------------------------------------------*/
#include <stdbool.h>
#include <stdint.h>

#include "gnss_vcp_mailbox.h"
#include "telemetry.h"

/* Exported types ------------------------------------------------------------*/
/**
  * @brief Consumer-side record of the last GPS status publication observed.
  *
  * The fix age is the time elapsed on the reading core's counter since the
  * publication that carried the fix was first observed, so the tracker holds
  * that publication and the local counter value of its first observation.
  * `change_seen` records whether that publication was observed to replace an
  * earlier one within one age window, i.e. whether the counter value it holds
  * actually bounds its age: only then may it be presented, and only until the
  * window has elapsed. It must be zero-initialised before the first read (all
  * zero means "nothing observed yet", which is also the state after a CPU2
  * reset) and then keep its value between reads of the same core.
  *
  * @note Do not copy the tracker between cores or reset it while the
  *       application runs: the recorded counter belongs to one clock.
  */
typedef struct
{
  uint32_t sequence;        /*!< seqlock sequence of the observed publication */
  uint32_t observed_ticks;  /*!< reading core's counter when it was first observed */
  bool     observed;        /*!< false until a publication has been recorded */
  bool     change_seen;     /*!< publication was seen to replace an earlier one
                                 within one age window, so observed_ticks bounds
                                 its age */
} TelemetryGpsSnapshotWatch;

/* Exported functions --------------------------------------------------------*/
/**
  * @brief  Takes a coherent, freshness-checked copy of the shared GPS status.
  * @param  shared  Shared snapshot published by CPU1, i.e. GNSS_VCP_GPS_STATUS.
  * @param  now_ticks  Current value of the reading core's free-running counter
  *                 (it may wrap). Never a value produced by the other core: it
  *                 is only ever compared with another value of this counter.
  * @param  ticks_per_second  Rate of that counter, i.e. how many counts the
  *                 reading core's clock produces per second. Zero or an
  *                 unknown rate is reported as no fix.
  * @param  watch   Zero-initialised tracker, reused for every call.
  * @param  status  Receives the status to use for telemetry; filled no-fix
  *                 whenever no fix may be presented.
  * @return true when a current valid fix was read; false when the caller must
  *         treat the balloon as having no fix, with `status` holding a no-fix
  *         status (fix_valid 0, coordinates and satellite count 0). False
  *         covers: a publication this core has not yet seen replaced (the
  *         first one it sees, and any one observed too late), an
  *         uninitialised shared status (CPU1 image without GNSS_VCP_Init(),
  *         random RAM), a snapshot that could not be copied because CPU1 kept
  *         writing, a no-fix status published by CPU1, and a fix whose observed
  *         publication is older than TELEMETRY_MAX_FIX_AGE_MS on the reading
  *         core's clock.
  * @note   A fix is presented only after this core has seen the publication
  *         replace an earlier one within one age window, so a snapshot CPU1
  *         published before this core started is never presented. The caller
  *         reads periodically (the telemetry interval), so a running CPU1
  *         supplies such a replacement within the first interval. The price of
  *         the guarantee is one interval reported as no fix after a (re)start,
  *         and one after a gap between two reads longer than the maximum age.
  * @note   No argument may be NULL: a NULL `status` is not written, any other
  *         NULL argument is reported as no fix with `status` filled in.
  * @note   Call only from the consumer core (CPU2). The seqlock copy is bounded
  *         (a few attempts, no waiting), so this is safe in a sequencer task.
  */
bool Telemetry_ReadGpsStatusSnapshot(const GnssVcpGpsStatus *shared,
                                     uint32_t now_ticks,
                                     uint32_t ticks_per_second,
                                     TelemetryGpsSnapshotWatch *watch,
                                     TelemetryGpsStatus *status);

#ifdef __cplusplus
}
#endif

#endif /* __TELEMETRY_GPS_STATUS_H__ */
</file>

<file path="Common/Telemetry/telemetry_test.c">
/*
 * Host tests for Common/Telemetry/telemetry.c.
 *
 * The codec is pure C with no HAL dependency, so it runs unchanged on the
 * development machine. Build and run from the MXproject directory:
 *
 *   cc -std=c11 -Wall -Wextra -Werror -fsanitize=address,undefined \
 *      -I Common/Telemetry -I CM4/Core/Inc \
 *      Common/Telemetry/telemetry.c Common/Telemetry/telemetry_test.c \
 *      -o /tmp/telemetry_test && /tmp/telemetry_test
 */

#include "telemetry.h"

#include <stdio.h>
#include <string.h>

static unsigned int failures;

/* Reference packet for a valid fix at 48.117300 N, 11.516667 E, 545.4 m, 8 sats. */
/* Generated by the encoder - do not manually calculate. */
static const uint8_t REF_PACKET_FIX[] = {
    0x01,                   /* version = 1 */
    0x01,                   /* type = GPS_STATUS */
    0x2A, 0x00,             /* sequence = 42 (little-endian) */
    0x01,                   /* fix_valid = 1 */
    0x34, 0x36, 0xDE, 0x02, /* latitude = 48117300 (little-endian) */
    0xFB, 0xBA, 0xAF, 0x00, /* longitude = 11516667 (little-endian) */
    0x0C, 0xD5, 0x00, 0x00, /* altitude = 54540 cm (little-endian) */
    0x08                    /* satellites = 8 */
};
_Static_assert(sizeof(REF_PACKET_FIX) == TELEMETRY_PACKET_SIZE, "REF_PACKET_FIX size mismatch");

static const uint8_t REF_PACKET_NO_FIX[] = {
    0x01,                   /* version = 1 */
    0x01,                   /* type = GPS_STATUS */
    0x2B, 0x00,             /* sequence = 43 */
    0x00,                   /* fix_valid = 0 */
    0x00, 0x00, 0x00, 0x00, /* latitude = 0 */
    0x00, 0x00, 0x00, 0x00, /* longitude = 0 */
    0x00, 0x00, 0x00, 0x00, /* altitude = 0 */
    0x00                    /* satellites = 0 */
};
_Static_assert(sizeof(REF_PACKET_NO_FIX) == TELEMETRY_PACKET_SIZE, "REF_PACKET_NO_FIX size mismatch");

/* Reference ACK packet for sequence 42 (little-endian). */
static const uint8_t REF_ACK_PACKET[] = {
    0x01,                   /* version = 1 */
    0x02,                   /* type = ACK */
    0x2A, 0x00              /* sequence = 42 (little-endian) */
};
_Static_assert(sizeof(REF_ACK_PACKET) == TELEMETRY_ACK_PACKET_SIZE, "REF_ACK_PACKET size mismatch");

static void check_encode_fix(void)
{
  TelemetryGpsStatus status = {0};
  uint8_t buffer[TELEMETRY_PACKET_SIZE];
  bool ok;

  status.fix_valid = 1;
  status.latitude_udeg = 48117300;
  status.longitude_udeg = 11516667;
  status.altitude_cm = 54540;
  status.satellites_used = 8;
  status.fix_timestamp_ms = 12345;
  status.fix_sequence = 1;

  ok = Telemetry_EncodeGpsStatus(&status, 42, buffer, sizeof(buffer));
  if (!ok)
  {
    printf("FAIL encode_fix: Telemetry_EncodeGpsStatus returned false\n");
    failures++;
    return;
  }
  if (memcmp(buffer, REF_PACKET_FIX, TELEMETRY_PACKET_SIZE) != 0)
  {
    printf("FAIL encode_fix: packet mismatch\n");
    for (uint16_t i = 0; i < TELEMETRY_PACKET_SIZE; i++)
    {
      if (buffer[i] != REF_PACKET_FIX[i])
      {
        printf("  byte %u: got 0x%02X, expected 0x%02X\n", i, buffer[i], REF_PACKET_FIX[i]);
      }
    }
    failures++;
    return;
  }
}

static void check_encode_no_fix(void)
{
  TelemetryGpsStatus status = {0};
  uint8_t buffer[TELEMETRY_PACKET_SIZE];
  bool ok;

  status.fix_valid = 0;
  status.latitude_udeg = 12345;      /* should be ignored */
  status.longitude_udeg = 67890;     /* should be ignored */
  status.altitude_cm = 100;          /* should be ignored */
  status.satellites_used = 5;        /* should be ignored */
  status.fix_timestamp_ms = 12345;
  status.fix_sequence = 1;

  ok = Telemetry_EncodeGpsStatus(&status, 43, buffer, sizeof(buffer));
  if (!ok)
  {
    printf("FAIL encode_no_fix: Telemetry_EncodeGpsStatus returned false\n");
    failures++;
    return;
  }
  if (memcmp(buffer, REF_PACKET_NO_FIX, TELEMETRY_PACKET_SIZE) != 0)
  {
    printf("FAIL encode_no_fix: packet mismatch\n");
    for (uint16_t i = 0; i < TELEMETRY_PACKET_SIZE; i++)
    {
      if (buffer[i] != REF_PACKET_NO_FIX[i])
      {
        printf("  byte %u: got 0x%02X, expected 0x%02X\n", i, buffer[i], REF_PACKET_NO_FIX[i]);
      }
    }
    failures++;
    return;
  }
}

static void check_decode_fix(void)
{
  TelemetryGpsStatus status = {0};
  uint16_t sequence = 0;
  bool ok;

  ok = Telemetry_DecodeGpsStatus(REF_PACKET_FIX, sizeof(REF_PACKET_FIX), &status, &sequence);
  if (!ok)
  {
    printf("FAIL decode_fix: Telemetry_DecodeGpsStatus returned false\n");
    failures++;
    return;
  }
  if (sequence != 42)
  {
    printf("FAIL decode_fix: sequence %u, expected 42\n", sequence);
    failures++;
  }
  if (status.fix_valid != 1)
  {
    printf("FAIL decode_fix: fix_valid %u, expected 1\n", status.fix_valid);
    failures++;
  }
  if (status.latitude_udeg != 48117300)
  {
    printf("FAIL decode_fix: latitude %d, expected 48117300\n", status.latitude_udeg);
    failures++;
  }
  if (status.longitude_udeg != 11516667)
  {
    printf("FAIL decode_fix: longitude %d, expected 11516667\n", status.longitude_udeg);
    failures++;
  }
  if (status.altitude_cm != 54540)
  {
    printf("FAIL decode_fix: altitude %d, expected 54540\n", status.altitude_cm);
    failures++;
  }
  if (status.satellites_used != 8)
  {
    printf("FAIL decode_fix: satellites %u, expected 8\n", status.satellites_used);
    failures++;
  }
}

static void check_decode_no_fix(void)
{
  TelemetryGpsStatus status = {0};
  uint16_t sequence = 0;
  bool ok;

  ok = Telemetry_DecodeGpsStatus(REF_PACKET_NO_FIX, sizeof(REF_PACKET_NO_FIX), &status, &sequence);
  if (!ok)
  {
    printf("FAIL decode_no_fix: Telemetry_DecodeGpsStatus returned false\n");
    failures++;
    return;
  }
  if (sequence != 43)
  {
    printf("FAIL decode_no_fix: sequence %u, expected 43\n", sequence);
    failures++;
  }
  if (status.fix_valid != 0)
  {
    printf("FAIL decode_no_fix: fix_valid %u, expected 0\n", status.fix_valid);
    failures++;
  }
  if (status.latitude_udeg != 0)
  {
    printf("FAIL decode_no_fix: latitude %d, expected 0\n", status.latitude_udeg);
    failures++;
  }
  if (status.longitude_udeg != 0)
  {
    printf("FAIL decode_no_fix: longitude %d, expected 0\n", status.longitude_udeg);
    failures++;
  }
  if (status.altitude_cm != 0)
  {
    printf("FAIL decode_no_fix: altitude %d, expected 0\n", status.altitude_cm);
    failures++;
  }
  if (status.satellites_used != 0)
  {
    printf("FAIL decode_no_fix: satellites %u, expected 0\n", status.satellites_used);
    failures++;
  }
}

static void check_version_mismatch(void)
{
  TelemetryGpsStatus status = {0};
  uint16_t sequence = 0;
  uint8_t bad_packet[TELEMETRY_PACKET_SIZE];
  bool ok;

  memcpy(bad_packet, REF_PACKET_FIX, TELEMETRY_PACKET_SIZE);
  bad_packet[0] = 0xFF; /* wrong version */

  ok = Telemetry_DecodeGpsStatus(bad_packet, TELEMETRY_PACKET_SIZE, &status, &sequence);
  if (ok)
  {
    printf("FAIL version_mismatch: should have rejected wrong version\n");
    failures++;
  }
}

static void check_type_mismatch(void)
{
  TelemetryGpsStatus status = {0};
  uint16_t sequence = 0;
  uint8_t bad_packet[TELEMETRY_PACKET_SIZE];
  bool ok;

  memcpy(bad_packet, REF_PACKET_FIX, TELEMETRY_PACKET_SIZE);
  bad_packet[1] = 0xFF; /* wrong type */

  ok = Telemetry_DecodeGpsStatus(bad_packet, TELEMETRY_PACKET_SIZE, &status, &sequence);
  if (ok)
  {
    printf("FAIL type_mismatch: should have rejected wrong type\n");
    failures++;
  }
}

static void check_short_buffer(void)
{
  TelemetryGpsStatus status = {0};
  uint16_t sequence = 0;
  bool ok;

  ok = Telemetry_DecodeGpsStatus(REF_PACKET_FIX, TELEMETRY_PACKET_SIZE - 1, &status, &sequence);
  if (ok)
  {
    printf("FAIL short_buffer: should have rejected short buffer\n");
    failures++;
  }

  ok = Telemetry_EncodeGpsStatus(&status, 1, NULL, 0);
  if (ok)
  {
    printf("FAIL short_buffer: should have rejected NULL buffer\n");
    failures++;
  }

  uint8_t tiny[8];
  ok = Telemetry_EncodeGpsStatus(&status, 1, tiny, sizeof(tiny));
  if (ok)
  {
    printf("FAIL short_buffer: should have rejected too-small buffer\n");
    failures++;
  }
}

static void check_bounds_latitude(void)
{
  TelemetryGpsStatus status = {0};
  uint8_t buffer[TELEMETRY_PACKET_SIZE];
  bool ok;

  status.fix_valid = 1;
  status.latitude_udeg = 90000001; /* just over 90 degrees */
  status.longitude_udeg = 0;
  status.altitude_cm = 0;
  status.satellites_used = 1;

  ok = Telemetry_EncodeGpsStatus(&status, 1, buffer, sizeof(buffer));
  if (ok)
  {
    printf("FAIL bounds_latitude: should have rejected latitude > 90 deg\n");
    failures++;
  }

  status.latitude_udeg = -90000001;
  ok = Telemetry_EncodeGpsStatus(&status, 1, buffer, sizeof(buffer));
  if (ok)
  {
    printf("FAIL bounds_latitude: should have rejected latitude < -90 deg\n");
    failures++;
  }
}


}RADIO_Ld_Opt_t;

/*******************************************Radio FSK enum*****************************************/

/*!
 * @brief Represents the modulation shaping parameter
 */
typedef enum
{
    RADIO_FSK_MOD_SHAPING_OFF                         = 0x00,

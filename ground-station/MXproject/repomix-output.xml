 *   cc -std=c11 -Wall -Wextra -Werror -fsanitize=address,undefined \
 *      -I CM4/Core/Inc CM4/Core/Src/nmea_gga.c CM4/tests/nmea_gga_test.c \
 *      -o /tmp/nmea_gga_test && /tmp/nmea_gga_test
 */


RadioPhyStatus_t SUBGRF_GetStatus( void )
{
    uint8_t stat = 0;
    RadioPhyStatus_t status = { .Value = 0 };

    SUBGRF_ReadCommand( RADIO_GET_STATUS, &stat, 1 );
    status.Fields.CmdStatus = ( stat & ( 0x07 << 1 ) ) >> 1;
    status.Fields.ChipMode = ( stat & ( 0x07 << 4 ) ) >> 4;

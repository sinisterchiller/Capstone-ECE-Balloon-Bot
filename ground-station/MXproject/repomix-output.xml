  APP_LOG(TS_OFF, VLEVEL_M, "\n\rTELEMETRY APP (PAYLOAD)\n\r");
#else
  APP_LOG(TS_OFF, VLEVEL_M, "\n\rGROUND STATION (RX ONLY)\n\r");
#endif
